<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIStyle.uss?fileID=7433441132597879392&amp;guid=9ce5ae935e0af4fa8ac3d752f1136f48&amp;type=3#UIStyle" />
    <ui:VisualElement name="container" style="flex-grow: 1;">
        <ui:Label text="Game Title" name="title" class="header" style="top: 85px;" />
        <ui:VisualElement name="buttons" style="flex-grow: 1; top: 150px;">
            <ui:Button text="Play" name="playButton" class="button" />
            <ui:Button text="How to Play" name="howtoplayButton" emoji-fallback-support="true" class="button" />
            <ui:Button text="Quit" name="quitButton" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button text="Credits" name="creditButton" class="button" style="align-self: flex-end; align-items: auto; width: 100px; height: 50px; font-size: 20px; bottom: 2px; right: 2px;" />
</ui:UXML>
