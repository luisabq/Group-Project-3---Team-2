<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIStyle.uss?fileID=7433441132597879392&amp;guid=9ce5ae935e0af4fa8ac3d752f1136f48&amp;type=3#UIStyle" />
    <ui:VisualElement name="container" class="container" style="flex-grow: 1; background-color: rgb(21, 28, 36); justify-content: center; align-content: center; background-image: url(&quot;project://database/Assets/UI%20Toolkit/TitleScreen.png?fileID=2800000&amp;guid=cd20db18457b441819d1be2255ea177c&amp;type=3#TitleScreen&quot;);">
        <ui:VisualElement name="buttons" style="flex-grow: 1; top: 627px; position: absolute; left: 767px; align-self: center;">
            <ui:Button text="Play" name="playButton" selectable="false" focusable="true" class="button" style="-unity-text-align: middle-center; background-position-y: center; width: 400px; height: 150px; font-size: 65px;" />
            <ui:Button text="How to Play" name="howtoplayButton" emoji-fallback-support="true" class="button" style="width: 400px; height: 150px; font-size: 65px;" />
            <ui:Button text="Quit" name="quitButton" class="button" style="width: 400px; height: 150px; font-size: 65px;" />
        </ui:VisualElement>
        <ui:Button text="Credits" name="creditButton" class="button" style="align-self: flex-end; align-items: auto; width: 10%; height: 10%; font-size: 43px; bottom: 10px; right: 20px; position: absolute;" />
    </ui:VisualElement>
</ui:UXML>
