    <ui:VisualElement name="container" style="flex-grow: 1; width: 1700px; align-self: center; height: 1000px; align-content: center; background-color: rgba(7, 8, 34, 0.6); position: absolute; justify-content: flex-start; top: 37px; right: auto; left: auto;">
