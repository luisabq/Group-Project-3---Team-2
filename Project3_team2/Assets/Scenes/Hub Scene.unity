  m_Script: {fileID: 11500000, guid: 067fde3fb8edd164e979e283ccaeed95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueUI: {fileID: 730180434}
  dialogueText: {fileID: 1343644148}
  lines:
  - "Captain, the ship\u2019s engines are down!\n"
  - Use your steam gun to power them back up.
  - "There\u2019s one here\u2014and one at the top."
  - Remember to use your steam gun by pressing 2.
  - Oh! Don't forget you also have your recall amulet.
  - Just press R to set a time anchor and press T to go back.
  - Do be wary, it's a bit unstable. It will bring you back after a bit.
  - Go talk to Franchesca, she'll guide you to the top of the ship.
  afterEngineLines:
  - You did it Captain!
  - The engines are back online.
  - Now you have to set our course.
  - Head to the table on the main deck with the map on it.
  - Once you've set our course, head back to the wheel and we're off!
  oneKeyLines:
  - Nice work Captain!
  - That's one piece secured.
  twoKeyLines:
  - You're close now.
  - Just one more piece left.
  threeKeyLines:
  - You have all the pieces Captain!
  - Let's find out what's in the chest!
