  m_Script: {fileID: 11500000, guid: 067fde3fb8edd164e979e283ccaeed95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueUI: {fileID: 199469080}
  dialogueText: {fileID: 272052545}
  lines:
  - Oi Captain Ash, it is so good to see you awake.
  - You're looking for the second engine? It's up top, remember?
  - Just switch over to your grappling gun by pressing 1.
  - 'Then aim at the top of the crows nest and shoot. '
  afterEngineLines:
  - That's my Captain!
  - We're ready to move again.
  - Go take control of the ship!
  oneKeyLines:
  - Oi! That's one down!
  - Let's keep going Captain!
  twoKeyLines:
  - HAHA, JUST ONE MORE CAPTAIN!
  threeKeyLines:
  - You did it!
  - Let's see what's in that chest!
